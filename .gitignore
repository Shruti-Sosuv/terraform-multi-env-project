cat > .gitignore <<'EOF'
# Terraform working directories
**/.terraform/*

# Terraform state and backups
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform crash logs
crash.log
crash.*.log

# Variable files may contain secrets
*.tfvars
*.tfvars.json

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
EOF
